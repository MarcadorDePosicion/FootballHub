# Docker Compose only; local development placeholders, never production secrets.
# Copy to .env at repository root; backend/.env is for local Python execution.
ENV=development
BACKEND_PORT=8000
POSTGRES_DB=footballhub
POSTGRES_USER=footballhub
# Use URL-safe characters (e.g. a random hex string) in DB credentials.
POSTGRES_PASSWORD=development-only-db-password
JWT_SECRET_KEY=development-only-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
FOOTBALL_DATA_MODE=demo
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_COMPETITIONS=PL
FOOTBALL_DATA_CACHE_TTL_SECONDS=120
FOOTBALL_DATA_MAX_REQUESTS_PER_MINUTE=10
FOOTBALL_DATA_DAYS_BACK=1
FOOTBALL_DATA_DAYS_FORWARD=1
